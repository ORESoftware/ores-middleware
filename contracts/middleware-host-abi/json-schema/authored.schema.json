{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oresoftware.com/middleware/host/v1/authored.schema.json",
  "title": "ORES middleware host ABI",
  "description": "Provider-neutral middleware host ABI with adapter capability profiles and distinct response-head availability, transport commitment, and terminal completion observations.",
  "oneOf": [
    { "$ref": "#/$defs/MiddlewareHostDescriptor" },
    { "$ref": "#/$defs/MiddlewareHostRequest" },
    { "$ref": "#/$defs/MiddlewareHostBeginResult" },
    { "$ref": "#/$defs/MiddlewareHostResponseHeadRequest" },
    { "$ref": "#/$defs/MiddlewareHostResponseHeadResult" },
    { "$ref": "#/$defs/MiddlewareHostFinishRequest" },
    { "$ref": "#/$defs/MiddlewareHostFinishResult" }
  ],
  "$defs": {
    "Sha256": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$" },
    "AdapterId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._/-]*$" },
    "HttpMethod": { "type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[A-Z0-9_-]+$" },
    "AbsolutePath": { "type": "string", "minLength": 1, "maxLength": 8192, "pattern": "^/[^\\r\\n\\u0000]*$" },
    "SessionId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "HttpStatus": { "type": "integer", "minimum": 100, "maximum": 599 },
    "NonNegativeUInt64": { "type": "integer", "minimum": 0 },
    "HeaderValue": { "type": "string", "pattern": "^[^\\r\\n\\u0000]*$" },
    "CanonicalHeaders": {
      "type": "object",
      "properties": {},
      "unevaluatedProperties": { "$ref": "#/$defs/HeaderValue" },
      "maxProperties": 256,
      "propertyNames": { "type": "string", "pattern": "^[a-z0-9!#$%&'*+.^_`|~-]+$" }
    },
    "MiddlewareHostExecutionModel": {
      "type": "string",
      "enum": ["local_process", "fetch_handler", "event_hooks", "lambda_events", "wasi_http"]
    },
    "MiddlewareHostCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "streamingResponse",
        "responseHeadAvailableObservation",
        "responseHeadCommitObservation",
        "bodyStreamCompletionObservation",
        "transportCompletionObservation",
        "clientDisconnectObservation",
        "backgroundWaitUntil",
        "wasmModule"
      ],
      "properties": {
        "streamingResponse": { "type": "boolean" },
        "responseHeadAvailableObservation": { "type": "boolean" },
        "responseHeadCommitObservation": { "type": "boolean" },
        "bodyStreamCompletionObservation": { "type": "boolean" },
        "transportCompletionObservation": { "type": "boolean" },
        "clientDisconnectObservation": { "type": "boolean" },
        "backgroundWaitUntil": { "type": "boolean" },
        "wasmModule": { "type": "boolean" }
      }
    },
    "MiddlewareHostResponseHeadPhase": {
      "type": "string",
      "enum": ["available", "committed"]
    },
    "MiddlewareHostCompletionBoundary": {
      "type": "string",
      "enum": ["body_stream", "transport"]
    },
    "MiddlewareHostOutcome": {
      "type": "string",
      "enum": ["completed", "disconnected", "timed_out", "child_failed"]
    },
    "MiddlewareHostDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "abiVersion", "middlewareContractVersion", "adapterId", "executionModel", "capabilities", "configSha256"],
      "properties": {
        "schema": { "type": "string", "const": "ores.middleware.host/v1" },
        "abiVersion": { "type": "string", "const": "1" },
        "middlewareContractVersion": { "type": "string", "minLength": 1 },
        "adapterId": { "$ref": "#/$defs/AdapterId" },
        "executionModel": { "$ref": "#/$defs/MiddlewareHostExecutionModel" },
        "capabilities": { "$ref": "#/$defs/MiddlewareHostCapabilities" },
        "configSha256": { "$ref": "#/$defs/Sha256" }
      }
    },
    "MiddlewareHostRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "method", "path", "headers", "trustedTransportSecure"],
      "properties": {
        "schema": { "type": "string", "const": "ores.middleware.host/v1" },
        "method": { "$ref": "#/$defs/HttpMethod" },
        "path": { "$ref": "#/$defs/AbsolutePath" },
        "headers": { "$ref": "#/$defs/CanonicalHeaders" },
        "trustedRemoteIp": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "contentLength": { "anyOf": [{ "$ref": "#/$defs/NonNegativeUInt64" }, { "type": "null" }] },
        "trustedTransportSecure": { "type": "boolean" }
      }
    },
    "MiddlewareHostPermit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "schema", "sessionId", "requestId", "traceId", "responseHeaders"],
      "properties": {
        "decision": { "type": "string", "const": "permit" },
        "schema": { "type": "string", "const": "ores.middleware.host/v1" },
        "sessionId": { "$ref": "#/$defs/SessionId" },
        "requestId": { "type": "string", "minLength": 1 },
        "traceId": { "type": "string", "minLength": 1 },
        "responseHeaders": { "$ref": "#/$defs/CanonicalHeaders" }
      }
    },
    "MiddlewareHostReject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "schema", "status", "code", "message", "headers"],
      "properties": {
        "decision": { "type": "string", "const": "reject" },
        "schema": { "type": "string", "const": "ores.middleware.host/v1" },
        "status": { "$ref": "#/$defs/HttpStatus" },
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string" },
        "headers": { "$ref": "#/$defs/CanonicalHeaders" }
      }
    },
    "MiddlewareHostBeginResult": {
      "anyOf": [{ "$ref": "#/$defs/MiddlewareHostPermit" }, { "$ref": "#/$defs/MiddlewareHostReject" }]
    },
    "MiddlewareHostResponseHeadRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "sessionId", "status", "phase"],
      "properties": {
        "schema": { "type": "string", "const": "ores.middleware.host/v1" },
        "sessionId": { "$ref": "#/$defs/SessionId" },
        "status": { "$ref": "#/$defs/HttpStatus" },
        "phase": { "$ref": "#/$defs/MiddlewareHostResponseHeadPhase" }
      }
    },
    "MiddlewareHostResponseHeadResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "status", "phase", "elapsedMs"],
      "properties": {
        "schema": { "type": "string", "const": "ores.middleware.host/v1" },
        "status": { "$ref": "#/$defs/HttpStatus" },
        "phase": { "$ref": "#/$defs/MiddlewareHostResponseHeadPhase" },
        "elapsedMs": { "$ref": "#/$defs/NonNegativeUInt64" }
      }
    },
    "MiddlewareHostFinishRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "sessionId", "status", "outcome", "completionBoundary"],
      "properties": {
        "schema": { "type": "string", "const": "ores.middleware.host/v1" },
        "sessionId": { "$ref": "#/$defs/SessionId" },
        "status": { "$ref": "#/$defs/HttpStatus" },
        "responseBytes": { "anyOf": [{ "$ref": "#/$defs/NonNegativeUInt64" }, { "type": "null" }] },
        "outcome": { "$ref": "#/$defs/MiddlewareHostOutcome" },
        "completionBoundary": { "$ref": "#/$defs/MiddlewareHostCompletionBoundary" }
      }
    },
    "MiddlewareHostFinishResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "outcome", "completionBoundary", "status", "totalDurationMs", "responseHeaders"],
      "properties": {
        "schema": { "type": "string", "const": "ores.middleware.host/v1" },
        "outcome": { "$ref": "#/$defs/MiddlewareHostOutcome" },
        "completionBoundary": { "$ref": "#/$defs/MiddlewareHostCompletionBoundary" },
        "status": { "$ref": "#/$defs/HttpStatus" },
        "timeToResponseHeadAvailableMs": { "anyOf": [{ "$ref": "#/$defs/NonNegativeUInt64" }, { "type": "null" }] },
        "timeToResponseHeadCommittedMs": { "anyOf": [{ "$ref": "#/$defs/NonNegativeUInt64" }, { "type": "null" }] },
        "totalDurationMs": { "$ref": "#/$defs/NonNegativeUInt64" },
        "responseHeaders": { "$ref": "#/$defs/CanonicalHeaders" }
      }
    }
  }
}
