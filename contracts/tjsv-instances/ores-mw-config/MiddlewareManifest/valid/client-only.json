{
  "schemaVersion": 1,
  "repositoryMode": "client-only",
  "allowOverlappingRoots": false,
  "defaultTarget": "web-client",
  "targets": [
    {
      "name": "web-client",
      "role": "client",
      "roots": ["web"],
      "enabled": true,
      "middleware": "propagation-only",
      "propagateHeaders": ["traceparent", "tracestate"]
    }
  ]
}
