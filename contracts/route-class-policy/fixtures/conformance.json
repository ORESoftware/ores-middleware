    {
      "id": "default-fallback",
      "table": {
        "schema": "ores.middleware.route-class-policies/v1",
        "default_class_id": "public-read",
        "classes": [
          {
            "id": "public-read",
            "overrides": {
              "rate_limit_policy_id": "public:read",
              "timeout_policy_id": "timeout:default"
            }
          },
          {
            "id": "auth-login",
            "extends": "public-read",
            "overrides": {
              "auth_policy_id": "auth:login",
              "rate_limit_policy_id": "auth:login-strict"
            },
            "security_override_intent": "preserve-or-strengthen"
          }
        ]
      },
      "expect": {
        "valid": true,
        "route_class_id": null,
        "resolved": {
          "route_class_id": "public-read",
          "lineage": [
            "public-read"
          ],
          "policies": {
            "rate_limit_policy_id": "public:read",
            "timeout_policy_id": "timeout:default"
          }
        }
      }
    },
