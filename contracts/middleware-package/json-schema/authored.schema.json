{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oresoftware.com/middleware/package/v1.json",
  "title": "ORES middleware package manifest",
  "description": "Independent JSON Schema authority for portable/provider-specific middleware artifact packaging. TypeSpec is a peer authority, not a generator source for this file.",
  "$ref": "#/$defs/MiddlewarePackageManifest",
  "$defs": {
    "Sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "MiddlewareArtifactDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "language",
        "kind",
        "profile",
        "provider",
        "path",
        "semantic_contract_sha256"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": [
            "javascript_module",
            "web_assembly_module",
            "native_library",
            "beam_module",
            "process_rpc"
          ]
        },
        "profile": {
          "enum": [
            "portable_javascript",
            "portable_wasm",
            "native",
            "isolated_process"
          ]
        },
        "provider": {
          "enum": ["generic", "cloudflare", "caddy", "nginx", "haproxy"]
        },
        "path": { "type": "string", "minLength": 1 },
        "semantic_contract_sha256": { "$ref": "#/$defs/Sha256Hex" }
      }
    },
    "MiddlewarePackageManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spec_version",
        "name",
        "version",
        "semantic_contract_sha256",
        "phases",
        "capabilities",
        "artifacts"
      ],
      "properties": {
        "spec_version": { "type": "integer", "const": 1 },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "semantic_contract_sha256": { "$ref": "#/$defs/Sha256Hex" },
        "phases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "capabilities": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/MiddlewareArtifactDescriptor" }
        }
      }
    }
  }
}
