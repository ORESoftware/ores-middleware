{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oresoftware.com/middleware/language-body-bindings.schema.json",
  "title": "ORES Middleware Language Body Bindings",
  "description": "Runtime evidence binding language-neutral pseudocode steps to reviewed native function/method bodies.",
  "$ref": "#/$defs/functionBodyBindings",
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
    },
    "requiredFragment": {
      "type": "string",
      "minLength": 2,
      "maxLength": 512
    },
    "forbiddenFragment": {
      "type": "string",
      "minLength": 3,
      "maxLength": 256
    },
    "language": {
      "type": "string",
      "enum": ["rust", "typescript", "golang", "gleam", "elixir", "erlang"]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "symbol",
        "sources",
        "stepEvidence",
        "forbiddenFragments"
      ],
      "properties": {
        "language": {
          "type": "string",
          "enum": ["rust", "typescript", "golang", "gleam", "elixir", "erlang"]
        },
        "symbol": {"type": "string", "minLength": 3, "maxLength": 256},
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/relativePath"}
        },
        "stepEvidence": {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "items": {"$ref": "#/$defs/stepEvidence"}
        },
        "forbiddenFragments": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/forbiddenFragment"}
        }
      }
    },
    "stepEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stepId", "source", "requiredFragments", "ordered"],
      "properties": {
        "stepId": {
          "$ref": "https://schemas.oresoftware.com/middleware/function-body-plan.schema.json#/$defs/safeIdentifier"
        },
        "source": {"$ref": "#/$defs/relativePath"},
        "requiredFragments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/requiredFragment"}
        },
        "ordered": {"type": "boolean"}
      }
    },
    "functionBodyBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "contractId", "plan", "bindings"],
      "properties": {
        "schemaVersion": {"type": "string", "const": "1.0.0"},
        "contractId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9._/-]*$"
        },
        "plan": {
          "type": "string",
          "pattern": "^contracts/function-bodies/[A-Za-z0-9._/-]+\\.json$"
        },
        "bindings": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {"$ref": "#/$defs/binding"}
        }
      }
    }
  }
}
