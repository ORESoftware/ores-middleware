{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oresoftware.com/middleware/v1/adapter-descriptor.schema.json",
  "title": "ORES Middleware Adapter Descriptor",
  "$defs": {
    "sdkOperation": {
      "type": "string",
      "enum": [
        "descriptor",
        "defaultConfig",
        "validateConfig",
        "createMiddleware",
        "runWithContext",
        "currentContext",
        "capabilities"
      ]
    },
    "adapterDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "language",
        "runtime",
        "packageName",
        "frameworkAdapters",
        "capabilities",
        "operationSymbols"
      ],
      "properties": {
        "contractVersion": {
          "const": "1.0.0",
          "type": "string"
        },
        "language": {
          "anyOf": [
            {
              "const": "rust",
              "type": "string"
            },
            {
              "const": "ts",
              "type": "string"
            },
            {
              "const": "gleam",
              "type": "string"
            },
            {
              "const": "golang",
              "type": "string"
            },
            {
              "const": "elixir",
              "type": "string"
            },
            {
              "const": "erlang",
              "type": "string"
            }
          ]
        },
        "runtime": {
          "type": "string",
          "minLength": 1
        },
        "packageName": {
          "type": "string",
          "minLength": 1
        },
        "frameworkAdapters": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://schemas.oresoftware.com/middleware/v1/middleware-stack.schema.json#/$defs/capability"
          }
        },
        "operationSymbols": {
          "$ref": "#/$defs/sdkOperationSymbols"
        }
      }
    },
    "sdkOperationSymbols": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "descriptor",
        "defaultConfig",
        "validateConfig",
        "createMiddleware",
        "runWithContext",
        "currentContext",
        "capabilities"
      ],
      "properties": {
        "descriptor": {
          "type": "string",
          "minLength": 1
        },
        "defaultConfig": {
          "type": "string",
          "minLength": 1
        },
        "validateConfig": {
          "type": "string",
          "minLength": 1
        },
        "createMiddleware": {
          "type": "string",
          "minLength": 1
        },
        "runWithContext": {
          "type": "string",
          "minLength": 1
        },
        "currentContext": {
          "type": "string",
          "minLength": 1
        },
        "capabilities": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$ref": "#/$defs/adapterDescriptor"
}
