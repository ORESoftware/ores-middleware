{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oresoftware.com/middleware/idempotency-scope/v2.json",
  "description": "Independently authored authority; never overwrite from TypeSpec output.",
  "$ref": "#/$defs/IdempotencyScope",
  "$defs": {
    "IdempotencyScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["serviceName", "tenantId", "userId", "method", "path", "query", "idempotencyKey"],
      "properties": {
        "serviceName": { "type": "string", "minLength": 1 },
        "tenantId": { "type": "string" },
        "userId": { "type": "string" },
        "method": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1, "pattern": "^/" },
        "query": { "type": "string" },
        "idempotencyKey": { "type": "string", "minLength": 1 }
      }
    }
  }
}
