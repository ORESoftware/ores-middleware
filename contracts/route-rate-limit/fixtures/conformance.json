{
  "schema": "ores.middleware.route-rate-limit-conformance/v1",
  "cases": [
    {
      "id": "valid-exact-route",
      "schema_valid": true,
      "runtime_valid": true,
      "config": {
        "schema": "ores.middleware.route-rate-limit-bindings/v1",
        "default_policy_id": "public-read-default",
        "routes": [
          {
            "route_class_id": "auth-login",
            "policy_id": "auth:login-strict",
            "selector": {
              "methods": ["POST"],
              "path_template": "/auth/login",
              "operation_id": "auth.login"
            }
          }
        ]
      },
      "request": {
        "method": "POST",
        "path": "/auth/login",
        "route_template": "/auth/login",
        "operation_id": "auth.login"
      },
      "expect": {
        "kind": "route",
        "route_class_id": "auth-login",
        "policy_id": "auth:login-strict"
      }
    },
    {
      "id": "valid-parameterized-query",
      "schema_valid": true,
      "runtime_valid": true,
      "config": {
        "schema": "ores.middleware.route-rate-limit-bindings/v1",
        "routes": [
          {
            "route_class_id": "ledger-entry",
            "policy_id": "ledger:read",
            "selector": {
              "methods": ["GET"],
              "path_template": "/ledger/{ledger_id}/entries/:entry_id"
            }
          }
        ]
      },
      "request": {
        "method": "GET",
        "path": "/ledger/a/entries/42?expand=true"
      },
      "expect": {
        "kind": "route",
        "route_class_id": "ledger-entry",
        "policy_id": "ledger:read"
      }
    },
    {
      "id": "valid-operation-precedence",
