    {
      "id": "valid-config-ambiguous-resolution",
      "schema_valid": true,
      "runtime_valid": true,
      "config": {
        "schema": "ores.middleware.route-rate-limit-bindings/v1",
        "routes": [
          {
            "route_class_id": "users-b",
            "policy_id": "users:beta",
            "selector": { "methods": ["GET"], "path_template": "/users/:id" }
          },
          {
            "route_class_id": "users-a",
            "policy_id": "users:alpha",
            "selector": { "methods": ["GET"], "path_template": "/users/{id}" }
          }
        ]
      },
      "request": { "method": "GET", "path": "/users/42" },
      "expect": {
        "kind": "ambiguous",
        "route_class_ids": ["users-a", "users-b"],
        "policy_ids": ["users:alpha", "users:beta"]
      }
    },
