      "config": {
        "schema": "ores.middleware.route-rate-limit-bindings/v1",
        "routes": [
          {
            "route_class_id": "job-path",
            "policy_id": "jobs:default",
            "selector": { "methods": ["POST"], "path_template": "/jobs/{job_id}" }
          },
          {
            "route_class_id": "job-retry",
            "policy_id": "jobs:retry",
            "selector": { "methods": ["POST"], "operation_id": "jobs.retry" }
          }
        ]
      },
      "request": {
        "method": "POST",
        "path": "/jobs/42",
        "route_template": "/jobs/{job_id}",
        "operation_id": "jobs.retry"
      },
      "expect": {
        "kind": "route",
        "route_class_id": "job-retry",
        "policy_id": "jobs:retry"
      }
    },
    {
      "id": "valid-default-fallback",
