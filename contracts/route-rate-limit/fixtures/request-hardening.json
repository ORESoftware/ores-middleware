{
  "schema": "ores.middleware.route-rate-limit-request-hardening/v1",
  "base_config": {
    "schema": "ores.middleware.route-rate-limit-bindings/v1",
    "default_policy_id": "public:default",
    "routes": [
      {
        "route_class_id": "users-read",
        "policy_id": "users:read",
        "selector": {
          "methods": [
            "GET"
          ],
          "path_template": "/users/{id}",
          "operation_id": "users.read"
        }
      }
    ]
  },
  "cases": [
    {
      "id": "valid-uppercase-query",
      "schema_valid": true,
      "runtime_valid": true,
      "request": {
        "method": "GET",
        "path": "/users/42?expand=1",
        "route_template": "/users/{id}",
        "operation_id": "users.read"
      },
      "expect": {
        "kind": "route",
        "route_class_id": "users-read",
        "policy_id": "users:read"
      }
    },
    {
      "id": "valid-lowercase-method",
      "schema_valid": true,
      "runtime_valid": true,
      "request": {
        "method": "get",
        "path": "/users/42",
        "operation_id": "users.read"
      },
      "expect": {
        "kind": "route",
        "route_class_id": "users-read",
        "policy_id": "users:read"
      }
    },
    {
      "id": "invalid-empty-method",
      "schema_valid": false,
      "runtime_valid": false,
      "request": {
        "method": "",
        "path": "/users/42"
      }
    },
    {
      "id": "invalid-method-space",
      "schema_valid": false,
      "runtime_valid": false,
      "request": {
        "method": "GE T",
        "path": "/users/42"
      }
    },
    {
      "id": "invalid-relative-path",
      "schema_valid": false,
      "runtime_valid": false,
      "request": {
        "method": "GET",
        "path": "users/42"
      }
    },
    {
      "id": "invalid-path-too-long",
      "schema_valid": false,
      "runtime_valid": false,
      "request": {
        "method": "GET",
        "path": ""
      }
    },
    {
      "id": "invalid-path-fragment",
      "schema_valid": false,
      "runtime_valid": false,
      "request": {
        "method": "GET",
        "path": "/users/42#frag"
      }
    },
    {
      "id": "invalid-path-crlf",
      "schema_valid": false,
      "runtime_valid": false,
      "request": {
        "method": "GET",
        "path": "/users/\r\n42"
      }
    },
    {
      "id": "runtime-invalid-repeated-slash",
      "schema_valid": true,
      "runtime_valid": false,
      "request": {
        "method": "GET",
        "path": "/users//42"
      }
    },
    {
      "id": "runtime-invalid-dot-segment",
      "schema_valid": true,
      "runtime_valid": false,
      "request": {
        "method": "GET",
        "path": "/users/./42"
      }
    },
    {
      "id": "runtime-invalid-dotdot-segment",
      "schema_valid": true,
      "runtime_valid": false,
      "request": {
        "method": "GET",
        "path": "/users/../42"
      }
    },
    {
      "id": "invalid-route-template-query",
      "schema_valid": false,
      "runtime_valid": false,
      "request": {
        "method": "GET",
        "path": "/users/42",
        "route_template": "/users/{id}?x=1"
      }
    },
    {
      "id": "invalid-operation-id-space",
      "schema_valid": false,
      "runtime_valid": false,
      "request": {
        "method": "GET",
        "path": "/users/42",
        "operation_id": "users read"
      }
    },
    {
      "id": "runtime-invalid-route-template-spoof",
      "schema_valid": true,
      "runtime_valid": false,
      "request": {
        "method": "GET",
        "path": "/admin/secret",
        "route_template": "/users/{id}",
        "operation_id": "users.read"
      }
    },
    {
      "id": "valid-empty-parameter-does-not-match",
      "schema_valid": true,
      "runtime_valid": true,
      "request": {
        "method": "GET",
        "path": "/users/",
        "operation_id": "users.read"
      },
      "expect": {
        "kind": "default",
        "policy_id": "public:default"
      }
    }
  ]
}
