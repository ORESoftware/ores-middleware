{
  "schema": "ores.middleware.quota-admission/v1",
  "limits": {"max_windows": 8},
  "cases": [
    {
      "id": "bounded-policy",
      "input": {"policy": "free-v3", "windows": [{"id": "minute", "limit": 60, "window_seconds": 60}], "concurrency_limit": 4, "queue_limit": 100, "default_cost": 1},
      "expected": {"admitted": true}
    },
    {
      "id": "duplicate-window-id",
      "input": {"policy": "bad", "windows": [{"id": "minute", "limit": 60, "window_seconds": 60}, {"id": "minute", "limit": 300, "window_seconds": 600}]},
      "expected": {"admitted": false, "reason": "duplicate_window_id"}
    },
    {
      "id": "zero-limit",
      "input": {"policy": "bad", "windows": [{"id": "minute", "limit": 0, "window_seconds": 60}]},
      "expected": {"admitted": false, "reason": "invalid_limit"}
    },
    {
      "id": "secret-bearing-policy",
      "input": {"policy": "bad", "redis_url": "redis://user:secret@example.invalid/0"},
      "expected": {"admitted": false, "reason": "secret_or_backend_coordinate_forbidden"}
    },
    {
      "id": "request-overrides-operation-cost",
      "input": {"policy": "free-v3", "operation_cost": 20, "request_operation_cost": 1},
      "expected": {"admitted": false, "reason": "request_cost_override_forbidden"}
    }
  ]
}
