{
  "schema": "ores.conformance.manifest/v1",
  "repository": "ORESoftware/ores-middleware",
  "contractRoots": ["contracts/"],
  "caseRoots": ["conformance/cases"],
  "caseSchema": "conformance/case.schema.json",
  "governanceRegistry": "governance/polyglot-participants.v1.json",
  "evidenceDir": "artifacts/conformance/evidence",
  "requiredParticipants": [
    {"id": "rust"},
    {"id": "ts"},
    {"id": "golang"},
    {"id": "gleam"},
    {"id": "elixir"},
    {"id": "erlang"}
  ],
  "coverage": {"status": "scaffold-only", "behavioralCasesRequired": false},
  "evidence": {"bindToContractDigests": true, "bindToCaseDigests": true, "missingRequiredEvidenceFails": true, "staleEvidenceFails": true},
  "policy": {"runtimeSpecificGoldensAllowed": false, "generatedEvidenceIsAuthority": false}
}
