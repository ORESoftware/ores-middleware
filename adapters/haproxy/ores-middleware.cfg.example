# ORES HAProxy edge/transport middleware example.
#
# Consumer *-infra repositories own concrete values/order/placement. This file
# is an example target, not a policy authority and not a production default.

global
  log stdout format raw local0

  # Example only. Consumer deployment owns process/thread sizing and TLS.
  maxconn 20000

defaults
  mode http
  log global

  # Do not use the stock httplog format here: it includes the full request URI,
  # including query strings. Keep access telemetry deliberately bounded.
  log-format 'request_id=%ID method=%HM path=%HP status=%ST bytes=%B total_ms=%Ta'

  timeout connect 3s
  timeout queue 5s
  timeout client 30s
  timeout server 30s
  timeout http-request 10s
  timeout http-keep-alive 10s

  # Generic middleware does not replay requests. Consumers may opt into retry
  # behavior only for operation classes explicitly classified safe/idempotent.
  retries 0

  # Make the recommended backend connection-reuse policy explicit instead of
  # inheriting an environment-specific override.
  http-reuse safe

# Use ipv6 tables: HAProxy accepts both IPv6 and IPv4 source addresses here,
# unlike type ip, which excludes IPv6 clients.
# Separate tables preserve separate windows/semantics for route policy classes.
backend ores_rl_default
  stick-table type ipv6 size 1m expire 1m store http_req_rate(10s)

backend ores_rl_auth_login
  stick-table type ipv6 size 1m expire 10m store http_req_rate(1m)

frontend ores_http
  bind :8080

  # Generate a random edge request ID that does not encode client IP/ports or
  # other transport identifiers. Never accept a public request ID as a trust
  # primitive.
  unique-id-format "%[uuid]"
  http-request set-header X-Request-ID %[unique-id]

  # Require an explicit deployment-owned Host allowlist. Entries are exact
  # lower-case Host header values; include port-qualified forms when accepted.
  acl ores_host_allowed req.hdr(host),lower -f /etc/haproxy/ores-allowed-hosts.lst
  # Use return rather than deny_status for 421. deny_status is intentionally
  # constrained by HAProxy's built-in errorfile status set on some supported
  # versions, while return can emit the protocol-correct Misdirected Request.
  http-request return status 421 if !ores_host_allowed

  # TRACE and CONNECT are not part of the generic HTTP reverse-proxy surface.
  acl ores_forbidden_method method TRACE CONNECT
  http-request deny deny_status 405 if ores_forbidden_method

  # HAProxy intentionally does not normalize request paths by default. Reject
  # common ambiguous forms here so route-specific middleware cannot be bypassed
  # when an origin/router would later normalize them differently.
  acl ores_path_double_slash path_reg //
  acl ores_path_dot_segment path_reg (^|/)\.{1,2}(/|$)
  http-request deny deny_status 400 if ores_path_double_slash
  http-request deny deny_status 400 if ores_path_dot_segment

  # Replace public forwarding metadata at this boundary. When HAProxy itself is
  # behind another proxy, use an explicitly trusted PROXY-protocol hop or other
  # reviewed transport mechanism rather than trusting arbitrary X-Forwarded-*.
  http-request del-header Forwarded
  http-request del-header X-Forwarded-For
  http-request del-header X-Forwarded-Proto
  http-request del-header X-Forwarded-Host
  http-request del-header X-Forwarded-Port
  http-request del-header X-Real-IP
  http-request del-header Proxy
  http-request set-header X-Forwarded-For %[src]
  http-request set-header X-Real-IP %[src]
  http-request set-header X-Forwarded-Proto http
  http-request set-header X-Forwarded-Proto https if { ssl_fc }

  # Preserve traceparent for distributed trace correlation, but do not forward
  # arbitrary public tracestate/baggage into internal services. Consumers may
  # re-enable a bounded, reviewed allowlist at a trusted internal boundary.
  http-request del-header tracestate
  http-request del-header baggage

  # Keep the generic proxy non-upgrade. WebSocket/h2c/tunnel routes need a
  # dedicated reviewed transport stack rather than broad hop-by-hop forwarding.
  http-request del-header Keep-Alive
  http-request del-header Proxy-Connection
  http-request del-header Upgrade
  http-request del-header TE
  http-request del-header Trailer

  # URL paths are case-sensitive here; do not broaden an exact route policy with
  # a case-insensitive match.
  acl ores_auth_login_path path /v1/auth/login
  acl ores_auth_login_method method POST

  # Example rates are non-authoritative. sc0 counts the general edge policy;
  # sc1 counts only POST /v1/auth/login in its own one-minute table.
  http-request track-sc0 src table ores_rl_default
  http-request track-sc1 src table ores_rl_auth_login if ores_auth_login_path ores_auth_login_method

  acl ores_default_rate_exceeded sc_http_req_rate(0,ores_rl_default) gt 200
  acl ores_auth_login_rate_exceeded sc_http_req_rate(1,ores_rl_auth_login) gt 10

  http-request deny deny_status 429 if ores_default_rate_exceeded
  http-request deny deny_status 429 if ores_auth_login_path ores_auth_login_method ores_auth_login_rate_exceeded

  # http-after-response applies to origin and HAProxy-generated responses,
  # including local 400/405/421/429 responses. Remove origin banner/policy copies,
  # then write one canonical edge value.
  http-after-response del-header X-Powered-By
  http-after-response set-header X-Content-Type-Options nosniff
  http-after-response set-header Referrer-Policy strict-origin-when-cross-origin
  http-after-response set-header X-Request-ID %[unique-id]

  default_backend ores_origin

backend ores_origin
  balance roundrobin
  option httpchk GET /healthz
  server origin1 127.0.0.1:8081 check
