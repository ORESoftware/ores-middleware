# ORES NGINX edge/transport middleware example.
#
# Consumer *-infra repositories own concrete values/order/placement. This file
# is an example target, not a policy authority and not a production default.

# Fail closed unless deployment supplies explicit trusted proxy CIDRs, e.g.
#   set_real_ip_from 10.0.0.0/8;
# Never generate 0.0.0.0/0 or ::/0 as a trusted proxy range.
include /etc/nginx/ores/trusted-proxies.conf;
real_ip_header X-Forwarded-For;
real_ip_recursive on;

# Keep request-target and header parsing conservative. Consumers that truly need
# underscore-bearing headers or non-merged path slashes must opt in explicitly
# and prove parity with the application router first.
merge_slashes on;
ignore_invalid_headers on;
underscores_in_headers off;

# Require an explicit deployment-owned Host allowlist. Example file entries:
#   api.example.com 1;
#   *.example.net 1;
map $host $ores_host_allowed {
  hostnames;
  default 0;
  include /etc/nginx/ores/allowed-hosts.map;
}

# TRACE and CONNECT are not part of the generic HTTP reverse-proxy surface.
map $request_method $ores_method_allowed {
  default 1;
  TRACE 0;
  CONNECT 0;
}

# Method-specific rate policies use an empty key when they do not apply. NGINX
# does not account requests whose limit_req_zone key evaluates to an empty
# string, so GET/HEAD/etc. on this path do not consume the POST login budget.
map $request_method $ores_auth_login_ip_key {
  default "";
  POST $binary_remote_addr;
}

# Distinct route policies get distinct zones unless their complete observable
# semantics are intentionally identical. Example rates are non-authoritative.
limit_req_zone $binary_remote_addr zone=ores_edge_default_ip:10m rate=20r/s;
limit_req_zone $ores_auth_login_ip_key zone=ores_auth_login_ip:10m rate=10r/m;

# Do not log query strings, headers, cookies, bodies, or raw client identity here.
log_format ores_json escape=json
  '{"request_id":"$request_id",'
  '"method":"$request_method",'
  '"path":"$uri",'
  '"status":$status,'
  '"request_time":$request_time,'
  '"upstream_time":"$upstream_response_time"}';

upstream ores_origin {
  server 127.0.0.1:8081;
  keepalive 64;
}

server {
  listen 8080;
  server_name _;
  server_tokens off;

  access_log /var/log/nginx/ores-access.log ores_json;

  # Fail closed on an unrecognized Host before forwarding to application code.
  if ($ores_host_allowed = 0) {
    return 421;
  }

  # The generic adapter is not a forward proxy or HTTP TRACE reflector.
  if ($ores_method_allowed = 0) {
    return 405;
  }

  # Bound slow-client resource occupancy independently of upstream deadlines.
  client_header_timeout 10s;
  client_body_timeout 10s;
  keepalive_timeout 30s;
  send_timeout 30s;

  # Edge rejection should be distinguishable from origin failures.
  limit_req_status 429;
  limit_req_log_level warn;

  # Replace public forwarding metadata at this trusted boundary. Because the
  # real_ip module has already validated the immediate proxy chain, $remote_addr
  # is the admitted client address here. Strip RFC 7239 Forwarded rather than
  # allowing a second, attacker-controlled forwarding authority downstream.
  proxy_set_header Forwarded "";
  proxy_set_header X-Forwarded-For $remote_addr;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_set_header X-Forwarded-Host "";
  proxy_set_header X-Forwarded-Port "";
  proxy_set_header X-Request-ID $request_id;
  proxy_set_header Host $host;

  # Do not forward a client-controlled legacy Proxy header into CGI-style
  # environments where it can become HTTP_PROXY.
  proxy_set_header Proxy "";

  # Preserve traceparent for distributed trace correlation, but do not forward
  # arbitrary public tracestate/baggage into internal services. Consumers may
  # re-enable a bounded, reviewed allowlist at a trusted internal boundary.
  proxy_set_header traceparent $http_traceparent;
  proxy_set_header tracestate "";
  proxy_set_header baggage "";

  # Generic proxying is deliberately non-upgrade. WebSocket/h2c/tunnel routes
  # must opt into their own reviewed transport stack instead of inheriting a
  # broad Upgrade/Connection pass-through.
  proxy_http_version 1.1;
  proxy_set_header Connection "";
  proxy_set_header Keep-Alive "";
  proxy_set_header Proxy-Connection "";
  proxy_set_header Upgrade "";
  proxy_set_header TE "";
  proxy_set_header Trailer "";
  proxy_connect_timeout 3s;
  proxy_send_timeout 30s;
  proxy_read_timeout 30s;

  # Generic shared middleware must not silently retry application operations.
  # Consumers may enable retries only for operations explicitly classified safe.
  proxy_next_upstream off;

  client_max_body_size 2m;

  # Edge-owned response metadata must not be duplicated or weakened by origin
  # values. Hide origin copies, then emit one canonical edge value on all paths.
  proxy_hide_header X-Content-Type-Options;
  proxy_hide_header Referrer-Policy;
  proxy_hide_header X-Request-ID;
  proxy_hide_header X-Powered-By;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header X-Request-ID $request_id always;

  # Coarse edge guard. Strict distributed/account limits still run in the app.
  location / {
    limit_req zone=ores_edge_default_ip burst=40 nodelay;
    proxy_pass http://ores_origin;
  }

  # The exact login location is selected instead of the generic location above,
  # so emit BOTH the general edge guard and the stricter POST-only policy here.
  location = /v1/auth/login {
    limit_req zone=ores_edge_default_ip burst=40 nodelay;
    limit_req zone=ores_auth_login_ip burst=5 nodelay;
    client_max_body_size 64k;
    proxy_pass http://ores_origin;
  }
}
