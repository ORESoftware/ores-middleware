# ORES NGINX edge/transport middleware example.
#
# Consumer *-infra repositories own concrete values/order/placement. This file
# is an example target, not a policy authority and not a production default.

# Fail closed unless deployment supplies explicit trusted proxy CIDRs, e.g.
#   set_real_ip_from 10.0.0.0/8;
# Never generate 0.0.0.0/0 or ::/0 as a trusted proxy range.
include /etc/nginx/ores/trusted-proxies.conf;
real_ip_header X-Forwarded-For;
real_ip_recursive on;

# Method-specific rate policies use an empty key when they do not apply. NGINX
# does not account requests whose limit_req_zone key evaluates to an empty
# string, so GET/HEAD/etc. on this path do not consume the POST login budget.
map $request_method $ores_auth_login_ip_key {
  default "";
  POST $binary_remote_addr;
}

# Distinct route policies get distinct zones unless their complete observable
# semantics are intentionally identical. Example rates are non-authoritative.
limit_req_zone $binary_remote_addr zone=ores_edge_default_ip:10m rate=20r/s;
limit_req_zone $ores_auth_login_ip_key zone=ores_auth_login_ip:10m rate=10r/m;

# Do not log query strings, headers, cookies, bodies, or raw client identity here.
log_format ores_json escape=json
  '{"request_id":"$request_id",'
  '"method":"$request_method",'
  '"path":"$uri",'
  '"status":$status,'
  '"request_time":$request_time,'
  '"upstream_time":"$upstream_response_time"}';

upstream ores_origin {
  server 127.0.0.1:8081;
  keepalive 64;
}

server {
  listen 8080;
  server_name _;
  server_tokens off;

  access_log /var/log/nginx/ores-access.log ores_json;

  # Bound slow-client resource occupancy independently of upstream deadlines.
  client_header_timeout 10s;
  client_body_timeout 10s;
  keepalive_timeout 30s;
  send_timeout 30s;

  # Edge rejection should be distinguishable from origin failures.
  limit_req_status 429;
  limit_req_log_level warn;

  # Replace public forwarding metadata at this trusted boundary. Because the
  # real_ip module has already validated the immediate proxy chain, $remote_addr
  # is the admitted client address here. Strip RFC 7239 Forwarded rather than
  # allowing a second, attacker-controlled forwarding authority downstream.
  proxy_set_header Forwarded "";
  proxy_set_header X-Forwarded-For $remote_addr;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_set_header X-Forwarded-Host "";
  proxy_set_header X-Forwarded-Port "";
  proxy_set_header X-Request-ID $request_id;
  proxy_set_header Host $host;

  # W3C trace headers are propagated as untrusted telemetry context, not
  # interpreted as identity or authorization evidence. Application OTel parsing
  # must reject malformed values.
  proxy_set_header traceparent $http_traceparent;
  proxy_set_header baggage $http_baggage;

  proxy_http_version 1.1;
  proxy_set_header Connection "";
  proxy_connect_timeout 3s;
  proxy_send_timeout 30s;
  proxy_read_timeout 30s;

  # Generic shared middleware must not silently retry application operations.
  # Consumers may enable retries only for operations explicitly classified safe.
  proxy_next_upstream off;

  client_max_body_size 2m;

  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;

  # Coarse edge guard. Strict distributed/account limits still run in the app.
  location / {
    limit_req zone=ores_edge_default_ip burst=40 nodelay;
    proxy_pass http://ores_origin;
  }

  # The login route gets BOTH the general edge guard and the stricter POST-only
  # policy. NGINX does not inherit the parent location limit_req after a local
  # limit_req is declared, so both directives are explicit here.
  location = /v1/auth/login {
    limit_req zone=ores_edge_default_ip burst=40 nodelay;
    limit_req zone=ores_auth_login_ip burst=5 nodelay;
    client_max_body_size 64k;
    proxy_pass http://ores_origin;
  }
}
